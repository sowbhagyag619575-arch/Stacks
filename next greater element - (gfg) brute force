class Solution {
    public ArrayList<Integer> nextLargerElement(int[] arr) {
      
       ArrayList <Integer> res = new ArrayList<>();
        int n = arr.length;
        
        for(int i = 0 ; i < n ; i++){
            int nextGreat = -1;
            
            for(int j = i + 1 ; j < n ; j++){
                
                if(arr[j]>arr[i]){
                    nextGreat = arr[j];
                    break;
                    
                }
                
            }
            res.add(nextGreat);
        }
        return res;
        
    }
}
